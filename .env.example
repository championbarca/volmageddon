# IBKR (TWS or IB Gateway must already be running and logged in)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_MAX_EXPIRIES=4
IBKR_STRIKES_PER_SIDE=10

# ThetaData Terminal (must already be running locally)
THETADATA_BASE_URL=http://127.0.0.1:25503
THETADATA_MAX_DTE=90
THETADATA_MIN_DTE=
THETADATA_STRIKE_RANGE=
THETADATA_TIMEOUT=60
# Discount-factor rate only; the forward is implied from the chain by put-call parity.
THETADATA_RATE=0.043
THETADATA_COMPUTE_GREEKS=true

# Macro MySQL (CPI reference months, FOMC statement dates). Optional.
# When unset, the desk reads MYSQL_HOST / MYSQL_USER / MYSQL_PASSWORD from
# MACRO_SETTINGS (default W:\Workspace\LiveTrading\settings.py), database Macro.
MACRO_DB_HOST=
MACRO_DB_USER=
MACRO_DB_PASSWORD=
MACRO_DB_NAME=Macro
MACRO_SETTINGS=

# SPY regular-hours 1-minute bars (FMP). Optional override.
SPY_1MIN_CSV=W:\Workspace\LiveTrading\USStocks\SPY_1min_OHLCV_FMP.csv

# Shared
DATA_DIR=./data
UNIVERSE_FILE=./config/universe.yaml
POLL_INTERVAL_SECONDS=60
